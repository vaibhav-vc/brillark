{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brillark.ai/schemas/business-model.schema.json",
  "title": "Business Model",
  "description": "The nine canvas blocks, each carrying its own evidence grade.",
  "type": "object",
  "required": [
    "venture_id",
    "version",
    "blocks"
  ],
  "properties": {
    "venture_id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "blocks": {
      "type": "object",
      "required": [
        "customer_segments",
        "value_propositions",
        "channels",
        "customer_relationships",
        "revenue_streams",
        "key_resources",
        "key_activities",
        "key_partners",
        "cost_structure"
      ],
      "properties": {
        "customer_segments": {
          "type": "object",
          "required": [
            "content",
            "evidence_grade"
          ],
          "properties": {
            "content": {
              "type": "string"
            },
            "evidence_grade": {
              "type": "string",
              "enum": [
                "measured",
                "sourced",
                "benchmarked",
                "estimated",
                "guessed"
              ],
              "description": "How well this is evidenced. 'guessed' may never be load-bearing at a stage gate."
            },
            "source_artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
